---------Most Common useEffect Patterns-------


1. API Fetch
useEffect(() => {
  fetchData();
}, []);


2. Document Title
useEffect(() => {
  document.title = title;
}, [title]);


3. Timer
useEffect(() => {
  const id = setInterval(() => {}, 1000);

  return () => clearInterval(id);
}, []);


4. Event Listener
useEffect(() => {
  window.addEventListener("resize", handleResize);

  return () => {
    window.removeEventListener("resize", handleResize);
  };
}, []);